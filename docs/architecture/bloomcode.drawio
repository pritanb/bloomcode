        <mxCell id="flows-title" value="&lt;b&gt;Two teaching flows, using the same platform capabilities&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#203047;text;strokeColor=none;fillColor=none;align=left;fontSize=25;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="740" width="1670" height="45" />
        </mxCell>
        <mxCell id="ordinary" value="&lt;b&gt;&lt;font style=&quot;font-size:23px&quot;&gt;Ordinary chat&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Snapshot → retrieve → answer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Load recent learning state. Search local&lt;br&gt;meaning + keyword evidence, including&lt;br&gt;counterexamples. Check source excerpts.&lt;br&gt;Pass bounded evidence to Codex.&lt;br&gt;&lt;br&gt;No extra model classification call." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#203047;rounded=1;arcSize=10;fillColor=#e8f1fc;strokeColor=#567fae;strokeWidth=1.5;spacing=18;" vertex="1" parent="1" data-source="python/bloom_tutor/answer_graph.py">
          <mxGeometry as="geometry" x="60" y="805" width="530" height="255" />
        </mxCell>
        <mxCell id="coaching" value="&lt;b&gt;&lt;font style=&quot;font-size:23px&quot;&gt;Explicit coaching&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Evidence → teach → wait for you&lt;/b&gt;&lt;br&gt;&lt;br&gt;Retrieve a completed attempt. Choose a&lt;br&gt;focus, ask a question, adapt to your reply.&lt;br&gt;Optionally expand evidence once.&lt;br&gt;Persist the teaching state with LangGraph.&lt;br&gt;&lt;br&gt;Model tools disabled in coaching calls." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#203047;rounded=1;arcSize=10;fillColor=#e8f1fc;strokeColor=#567fae;strokeWidth=1.5;spacing=18;" vertex="1" parent="1" data-source="python/bloom_tutor/coaching/graph.py">
          <mxGeometry as="geometry" x="635" y="805" width="530" height="255" />
        </mxCell>
        <mxCell id="approval" value="&lt;b&gt;&lt;font style=&quot;font-size:23px&quot;&gt;Learner stays in control&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Propose → confirm → validated save&lt;/b&gt;&lt;br&gt;&lt;br&gt;Model proposals alone change nothing.&lt;br&gt;You confirm goals or preferences in the UI.&lt;br&gt;Python applies the confirmed change&lt;br&gt;through the authorised backend path.&lt;br&gt;&lt;br&gt;No autonomous score or schedule writes." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#203047;rounded=1;arcSize=10;fillColor=#f7f8fa;strokeColor=#c8cfd8;strokeWidth=1.5;spacing=18;" vertex="1" parent="1" data-source="python/bloom_tutor/session.py; src/server/tutor/conversation.ts">
          <mxGeometry as="geometry" x="1210" y="805" width="530" height="255" />
        </mxCell>
        <mxCell id="footnote" value="Blue: local components and logic · Purple: model calls · Green: local storage&lt;br&gt;Tutor files and coaching checkpoints are separate from the study-database backup. Python is not yet bundled in releases." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#203047;text;strokeColor=none;fillColor=none;align=left;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1090" width="1680" height="60" />
        </mxCell>
