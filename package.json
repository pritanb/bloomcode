{
  "name": "bloomcode",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/core/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsup",
    "test:smoke": "npm run build && node tests/smoke/runtime.mjs",
    "mcp": "node --env-file-if-exists=.env --import tsx src/integrations/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "import:pack": "node --env-file-if-exists=.env --import tsx scripts/import-pack.ts",
    "import:lists": "node --env-file-if-exists=.env --import tsx scripts/import-lists.ts",
    "demo": "node --import tsx scripts/demo.mjs",
    "electron:dev": "npm run build && node scripts/electron.mjs dev",
    "electron:package": "npm run build && node scripts/electron.mjs package",
    "electron:make": "npm run build && node scripts/electron.mjs make",
    "eval:insights": "node --import tsx scripts/evaluate-insights.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:tutor": "node --import tsx tests/integrations/coaching-eval.mjs"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.102.8",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "fastify": "^5.12.4",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.8.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.9",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.23.0"
  }
}
